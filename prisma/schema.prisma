generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int       @id @default(autoincrement())
  targetPage String    @default("common") 
  title     String
  content   String
  author    String
  authorId    String?
  authorImage String?  // 작성자 프로필 사진
  noticeType  Int       @default(2) // [추가] 0:전체공지, 1:페이지공지, 2:일반
  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id          Int      @id @default(autoincrement())
  content     String
  author      String
  authorId    String?
  authorImage String?  // 작성자 프로필 사진
  createdAt   DateTime @default(now())
  postId      Int
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model User {
  id           Int      @id @default(autoincrement())
  naverId      String   @unique // 네이버 고유 식별값 (불변)
  name         String
  gender       String?
  birthyear    String?  // 출생년도 (YYYY)
  mobile       String?  // [추가] 휴대전화번호 (010-0000-0000)
  profileImage String?  // 프로필 사진 URL
  lastLogin    DateTime @default(now())
  createdAt    DateTime @default(now())
}

// 기존 모델들 아래에 추가

model RecordRequest {
  id        Int      @id @default(autoincrement())
  
  // 원본 레코드 식별 키 (Composite Key 역할)
  raceName  String   // rn: 대회명
  year      String   // y: 연도
  bib       String   // b: 배번
  name      String   // n: 이름
  
  // 수정할 데이터 (JSON 형태로 저장하여 유연성 확보)
  // 예: { "t": 36000, "r": 12000 }
  updatedFields String 

  // 상태 관리
  status    String   @default("PENDING") // PENDING(대기), COMPLETED(반영완료)
  
  // 요청자 정보
  requester String   // 네이버 아이디 또는 이름
  
  createdAt DateTime @default(now())
  processedAt DateTime?
  
  // 식별 키에 인덱스 걸기 (검색 속도 향상)
  @@index([raceName, year, bib, name])
}